VITE_APP_TITLE=Musiiik
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_VERSION=0.0.0
NODE_ENV=development

# Audiomack API credentials
# Get these from: https://developer.audiomack.com/
# 1. Register an application at https://developer.audiomack.com/
# 2. Get your CONSUMER_KEY and CONSUMER_SECRET
# 3. Set these environment variables to enable Audiomack integration
VITE_AUDIOMACK_CONSUMER_KEY=
VITE_AUDIOMACK_CONSUMER_SECRET=

# Audius API credentials
# Get these from https://api.audius.co/plans or audius.co/settings
# Read-only endpoints work without them; the API key only raises rate limits.
# VITE_AUDIUS_API_SECRET is the key secret for signed write requests
# (upload/favorite/repost) and is intentionally unused by the read-only service.
VITE_AUDIUS_APP_NAME=musiik
VITE_AUDIUS_API_KEY=
VITE_AUDIUS_API_SECRET=